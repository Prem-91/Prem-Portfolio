# Public (browser-safe) values
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server values (set in your host's environment variables, never commit real values)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI chatbot ("Ask about Prem")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: automatic content backup to a second Supabase project
DB_PROJECT_URL=
DB_SERVICE_ROLE_KEY=

# Optional: only for drizzle-kit migrations
DATABASE_URL=
